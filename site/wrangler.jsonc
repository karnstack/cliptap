{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cliptap-site",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // src/server.ts wraps the TanStack Start handler and redirects www to the apex domain.
  "main": "src/server.ts",
  "routes": [
    { "pattern": "cliptap.app", "custom_domain": true },
    { "pattern": "www.cliptap.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
